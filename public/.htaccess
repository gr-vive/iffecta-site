# iffecta.ru — Apache config for Beget shared hosting.
# Security headers, caching, compression, clean URLs, custom 404.

Options -Indexes
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Force HTTPS and non-www, but only on the production domain
  # (the Beget technical subdomain keeps working for previews).
  RewriteCond %{HTTP_HOST} ^www\.iffecta\.ru$ [NC]
  RewriteRule ^(.*)$ https://iffecta.ru/$1 [R=301,L]
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} ^iffecta\.ru$ [NC]
  RewriteRule ^(.*)$ https://iffecta.ru/$1 [R=301,L]
  # /privacy -> /privacy/ (one canonical form per page)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(privacy|terms|consent|oferta)$ /$1/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; media-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
  # HSTS: only sent over HTTPS, harmless on HTTP
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
  # Long cache for static assets, short for HTML
  <FilesMatch "\.(jpg|jpeg|png|webp|avif|mp4|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt|webmanifest)$">
    Header set Cache-Control "public, max-age=600, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType video/mp4 .mp4
</IfModule>

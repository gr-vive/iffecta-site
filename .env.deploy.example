# IFFECTA — Beget FTP deploy credentials. Copy to `.env.deploy` and fill in.
# `.env.deploy` is gitignored. Values: cp.beget.com → FTP (BeautyCevtika Beget account).
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
FTP_PORT=21
FTP_SECURE=true
# Site docroot on Beget (created when the site "iffecta" is added in the panel)
FTP_REMOTE_DIR=/iffecta/public_html

# Optional — only if Claude should create the site via Beget API (cp.beget.com account login)
BEGET_LOGIN=
BEGET_PASSWORD=
